{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "package:win": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "package:dir": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "test:packaged": {
      "dependsOn": [
        "package:dir"
      ],
      "cache": false
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    }
  }
}
